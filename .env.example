APP_NAME="SmartPOS Product Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8003

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_PORT=8003

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=product-mysql
DB_PORT=3306
DB_DATABASE=smartpos_product
DB_USERNAME=smartpos
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=smartpos
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/smartpos
AWS_USE_PATH_STYLE_ENDPOINT=true
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=product_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@smartpos.local"
MAIL_FROM_NAME="${APP_NAME}"

# JWT Authentication (Asymmetric RS256 verification using Identity Service Public Key)
JWT_SECRET=
JWT_ALGO=RS256
JWT_PUBLIC_KEY=file://storage/certs/jwt-public.pem

# Internal Microservice URLs
IDENTITY_SERVICE_URL=http://identity-service:8000
BUSINESS_SERVICE_URL=http://business-service:8000

